# ---------------------------------------------------------------------------
# Brainbox / Knowledge Platform - environment
# Copy to `.env` and fill in. Docker Compose reads `.env` automatically.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma separated. Behind Pangolin you usually set your public hostname here.
DJANGO_ALLOWED_HOSTS=*
# Comma separated full origins for CSRF, e.g. https://brainbox.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
POSTGRES_DB=brainbox
POSTGRES_USER=brainbox
POSTGRES_PASSWORD=change-me
# Optional override; compose builds this from the POSTGRES_* values above.
# DATABASE_URL=postgres://brainbox:change-me@db:5432/brainbox

# --- Storage ---------------------------------------------------------------
# Container path for the knowledge source-of-truth files.
BRAINBOX_DATA_ROOT=/data/knowledge

# --- Networking ------------------------------------------------------------
# Host port published by the web container (Pangolin proxies to this).
BRAINBOX_PORT=8000

# --- Image tag (TrueNAS pulls this tag from GHCR) --------------------------
# latest | main | sha-xxxxxxx | v1.2.3
BRAINBOX_TAG=latest

# --- First boot bootstrap (optional) ---------------------------------------
# If set, the entrypoint creates/updates this superuser on startup.
BRAINBOX_ADMIN_USERNAME=
BRAINBOX_ADMIN_EMAIL=
BRAINBOX_ADMIN_PASSWORD=

# --- Git integration (Phase 2) ---------------------------------------------
# Shared token injected into HTTPS remotes. Per-repository credentials arrive
# with the Secret Vault (Phase 5). Leave empty for public repositories.
BRAINBOX_GIT_TOKEN=
BRAINBOX_GIT_AUTHOR_NAME=Brainbox
BRAINBOX_GIT_AUTHOR_EMAIL=brainbox@localhost

# --- Secret vault master key (used from Phase 5 onwards) -------------------
# 32 url-safe bytes, base64. Generate:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BRAINBOX_SECRET_KEY=
