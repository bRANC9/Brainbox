# ---------------------------------------------------------------------------
# Brainbox / Knowledge Platform - environment
# Copy to `.env` and fill in. Docker Compose reads `.env` automatically.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Comma separated. Behind Pangolin you usually set your public hostname here.
DJANGO_ALLOWED_HOSTS=*
# Comma separated full origins for CSRF, e.g. https://brainbox.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
POSTGRES_DB=brainbox
POSTGRES_USER=brainbox
POSTGRES_PASSWORD=change-me
# Optional override; compose builds this from the POSTGRES_* values above.
# DATABASE_URL=postgres://brainbox:change-me@db:5432/brainbox

# --- Storage ---------------------------------------------------------------
# Container path for the knowledge source-of-truth files.
BRAINBOX_DATA_ROOT=/data/knowledge

# --- Networking ------------------------------------------------------------
# Host port published by the web container (Pangolin proxies to this).
BRAINBOX_PORT=8000

# --- Image tag (TrueNAS pulls this tag from GHCR) --------------------------
# latest | main | sha-xxxxxxx | v1.2.3
BRAINBOX_TAG=latest

# --- First boot bootstrap (optional) ---------------------------------------
# If set, the entrypoint creates/updates this superuser on startup.
BRAINBOX_ADMIN_USERNAME=
BRAINBOX_ADMIN_EMAIL=
BRAINBOX_ADMIN_PASSWORD=

# --- Git integration (Phase 2) ---------------------------------------------
# Shared token injected into HTTPS remotes. Per-repository credentials arrive
# with the Secret Vault (Phase 5). Leave empty for public repositories.
BRAINBOX_GIT_TOKEN=
BRAINBOX_GIT_AUTHOR_NAME=Brainbox
BRAINBOX_GIT_AUTHOR_EMAIL=brainbox@localhost
# Optional: enables GitHub pull-request creation from MCP (`knowledge_create_pull_request`)
BRAINBOX_GITHUB_TOKEN=

# --- Embeddings / search (Phase 3) -----------------------------------------
# deterministic = offline hashed embedding (no external service, default)
# openai        = any OpenAI-compatible /embeddings endpoint
BRAINBOX_EMBEDDING_PROVIDER=deterministic
BRAINBOX_EMBEDDING_MODEL=text-embedding-3-small
BRAINBOX_EMBEDDING_DIM=256
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BRAINBOX_CHUNK_SIZE=1200
BRAINBOX_CHUNK_OVERLAP=150
BRAINBOX_AUTO_INDEX=1
# simple = DB-agnostic contains search; postgres = full-text ranking (PostgreSQL only)
BRAINBOX_SEARCH_BACKEND=simple
# Optional Qdrant vector store. Leave empty to use the built-in local store.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=brainbox_chunks

# --- Reranking (Phase 3 rerank step) ---------------------------------------
# none | heuristic (default) | crossencoder (needs a /rerank endpoint)
BRAINBOX_RERANKER=heuristic
BRAINBOX_RERANK_TOP_N=50
BRAINBOX_RERANK_URL=
BRAINBOX_RERANK_MODEL=

# --- Secret vault (Phase 5) -------------------------------------------------
# off | warn | reject  (scan documents for likely committed credentials)
BRAINBOX_SECRET_SCAN_MODE=off

# --- AI drafts (Phase 7) ----------------------------------------------------
# noop = offline skeleton draft (default); openai = any OpenAI-compatible chat API
BRAINBOX_LLM_PROVIDER=noop
BRAINBOX_LLM_MODEL=gpt-4o-mini
BRAINBOX_STALE_DAYS=180

# --- Background jobs (DB-backed scheduler + worker) ------------------------
BRAINBOX_SCHEDULER_ENABLED=1
BRAINBOX_SCHEDULER_TICK_SEC=30
BRAINBOX_JOB_LOCK_TTL_SEC=120
BRAINBOX_JOB_POLL_SEC=3
BRAINBOX_JOB_HISTORY_DAYS=30

# --- Monitoring (Prometheus) ------------------------------------------------
# Leave empty for an open /metrics; set a token to require
# "Authorization: Bearer <token>".
BRAINBOX_METRICS_TOKEN=

# --- OIDC / SSO (Phase 6, optional) ----------------------------------------
# Set OIDC_ENABLED=1 to show "Sign in with SSO" and enable /accounts/oidc/.
OIDC_ENABLED=0
OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Optional overrides (derived from OIDC_ISSUER when empty)
OIDC_AUTHORIZE_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_AUTO_CREATE_USERS=1
# Comma separated group names auto-assigned to SSO users
OIDC_DEFAULT_GROUPS=

# --- Secret vault master key (encrypts secrets at rest) --------------------
# 32 url-safe bytes, base64. Generate:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating this makes existing secrets undecryptable.
BRAINBOX_SECRET_KEY=
